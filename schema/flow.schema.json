{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "业务流程映射 v1（分析协议 v2）",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedHash", "flows"],
  "properties": {
    "expectedHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "entryId", "nodes", "edges", "scenarios"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "entryId": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "featureId", "step"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "featureId": {
                  "type": "string",
                  "minLength": 1
                },
                "step": {
                  "type": "integer",
                  "minimum": 0
                },
                "unitId": {
                  "type": "string",
                  "minLength": 1
                },
                "contextId": {
                  "type": "string",
                  "minLength": 1
                },
                "relatedUnitIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "pointIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "inputs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "outputs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "from", "to", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": ["call", "data", "event", "http", "workflow"]
                },
                "callId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "targetId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "kind",
                "entryNode",
                "terminalNodes",
                "edges",
                "assertions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": ["normal", "exception"]
                },
                "entryNode": {
                  "type": "string",
                  "minLength": 1
                },
                "terminalNodes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "edges": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "assertions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["nodeId", "event", "operator"],
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "valueId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "event": {
                        "enum": ["enter", "return", "throw", "value", "branch", "point"]
                      },
                      "operator": {
                        "enum": ["exists", "equals", "type"]
                      },
                      "expected": {
                        "type": ["string", "number", "boolean", "null"],
                        "description": "equals 比较 JSON 标量；数值必须有限，整数须在 JavaScript 安全整数范围内。"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "reason"],
        "properties": {
          "entryId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
