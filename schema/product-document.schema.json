{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "产品蓝图文档 v1",
  "description": "AI 只填写业务数据。布局、HTML、CSS、SVG 坐标和交互由固定模板负责。跨记录引用、版本对应和步骤数量还需执行 CLI validate。未知历史字段会保留，但不会作为自定义页面代码执行。",
  "type": "object",
  "required": ["schemaVersion", "product", "features", "dependencies"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "background": {
          "type": "string"
        },
        "actors": {
          "$ref": "#/$defs/texts"
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/feature"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "diagrams": {
      "type": "object",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/graph"
        },
        "entities": {
          "$ref": "#/$defs/graph"
        }
      }
    },
    "flowVerification": {
      "type": "object",
      "description": "flow sync 生成的流程核验展示记录，独立于功能完成历史；严格检查仍读取分析会话和真实执行。",
      "properties": {
        "version": {
          "const": 1
        },
        "snapshotHash": {
          "type": "string"
        },
        "features": {
          "type": "object"
        },
        "globalGaps": {
          "type": "array"
        },
        "scope": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "graphId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "feature": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "rules",
        "flow",
        "stepDetails",
        "dependencies",
        "groupPath",
        "revision",
        "flowRevision",
        "implementedRevision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "\\S"
        },
        "overview": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "具体功能的待确认问题或必要说明。"
        },
        "annotations": {
          "type": "array",
          "description": "用户批注与修改想法，独立于已确认的定义，不改变定义版本或完成状态。",
          "items": {
            "type": "object",
            "required": ["id", "text", "createdAt", "definitionRevision"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "definitionRevision": {
                "$ref": "#/$defs/revision"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "rules": {
          "$ref": "#/$defs/texts"
        },
        "actors": {
          "$ref": "#/$defs/texts"
        },
        "checks": {
          "$ref": "#/$defs/texts"
        },
        "impact": {
          "$ref": "#/$defs/texts"
        },
        "dependencies": {
          "$ref": "#/$defs/ids"
        },
        "groupPath": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "not": {
                  "pattern": "[/／>]"
                }
              }
            ]
          },
          "description": "按业务模块分层，通常 2–3 层；不用源代码目录替代业务分组。空数组表示未分组。"
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/nonempty"
              },
              {
                "type": "string"
              }
            ],
            "description": "前两个元素为步骤名称与简述；新文档只需这两个元素，不生成图标或坐标。"
          }
        },
        "stepDetails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "revision": {
          "$ref": "#/$defs/revision",
          "description": "业务定义、规则、步骤、验收或功能依赖等规范内容变更时由工具递增；名称和分组不影响此版本。"
        },
        "editRevision": {
          "$ref": "#/$defs/revision",
          "description": "每次实际保存递增，用于拒绝旧页面；定义、流程同步和验收登记均计入。"
        },
        "flowRevision": {
          "$ref": "#/$defs/revision",
          "description": "外部 AI 显式同步业务流程时绑定当前定义版本。当前完成状态要求非空流程已同步。"
        },
        "implementedRevision": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        },
        "dataflow": {
          "$ref": "#/$defs/graph"
        },
        "implementationHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/implementation"
          },
          "description": "工具登记新验收记录时保留上一条记录；不由一般业务编辑操作改写。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "implementedRevision": {
                "type": "integer"
              }
            },
            "required": ["implementedRevision"]
          },
          "then": {
            "required": ["implementation"]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "actor",
        "description",
        "rules",
        "dependencies",
        "result",
        "exception",
        "interactions",
        "acceptance"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/texts"
        },
        "dependencies": {
          "$ref": "#/$defs/ids"
        },
        "result": {
          "type": "string"
        },
        "exception": {
          "type": "string"
        },
        "acceptance": {
          "type": "string"
        },
        "dependenciesPending": {
          "type": "boolean"
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "发送者、接收者、自然语言行为。"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["revision", "verifiedAt", "checks"],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "commit": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "result"],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonempty"
              },
              "result": {
                "const": "passed"
              },
              "executionId": {
                "type": "string",
                "pattern": "^v-[a-f0-9-]{36}$",
                "description": "verification run 生成的执行编号；严格完成和交付检查会核对真实记录与日志。"
              }
            }
          }
        },
        "sourceSnapshot": {
          "$ref": "#/$defs/sourceSnapshot",
          "readOnly": true,
          "description": "工具在分析会话下完成登记时自动绑定；旧记录可缺省，不代表源码已核验。"
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "category": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        },
        "relations": {
          "$ref": "#/$defs/ids"
        },
        "openQuestions": {
          "$ref": "#/$defs/texts"
        }
      }
    },
    "sequence": {
      "type": "object",
      "required": ["roles", "base", "normal"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "success": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        },
        "base": {
          "$ref": "#/$defs/messages"
        },
        "normal": {
          "$ref": "#/$defs/messages"
        },
        "error": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "message": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "$ref": "#/$defs/revision"
        },
        {
          "$ref": "#/$defs/nonempty"
        },
        {
          "$ref": "#/$defs/revision"
        },
        {
          "enum": ["return", "error"]
        }
      ],
      "description": "发送者序号、接收者序号、行为、所属步骤序号、可选返回或异常标记。序号从 0 开始。"
    },
    "graph": {
      "type": "object",
      "required": ["title", "nodes", "edges"],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "description": "只生成节点与语义关系；模板计算排布。"
    },
    "node": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/graphId"
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "type": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/texts"
        },
        "fields": {
          "$ref": "#/$defs/texts"
        },
        "dependency": {
          "$ref": "#/$defs/id"
        },
        "dependencies": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/graphId"
        },
        "to": {
          "$ref": "#/$defs/graphId"
        },
        "label": {
          "type": "string"
        },
        "dashed": {
          "type": "boolean"
        },
        "relation": {
          "type": "boolean"
        }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "required": [
        "version",
        "root",
        "snapshotHash",
        "parserVersion",
        "indexVersion",
        "scope",
        "manifest"
      ],
      "properties": {
        "version": {
          "enum": [1, 2]
        },
        "analyzers": {
          "type": "object",
          "description": "v2 源码基线绑定的各语言解析器版本、语法指纹及能力。"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1
        },
        "indexVersion": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "object",
          "required": ["include", "exclude"],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "contexts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "kind"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["source", "types", "context", "unsupported", "unreadable"]
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": 2
              }
            }
          },
          "then": {
            "required": ["analyzers"]
          }
        }
      ]
    }
  }
}
