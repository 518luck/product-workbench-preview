{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "显式验收与流程观测 v2",
  "type": "object",
  "required": ["command", "args"],
  "additionalProperties": false,
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "content"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "args"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        }
      }
    },
    "build": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "args"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        }
      }
    },
    "browser": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "scenarioId"],
      "properties": {
        "planId": {
          "type": "string",
          "minLength": 1
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": ["consumer", "provider"]
        }
      }
    },
    "purpose": {
      "enum": ["acceptance", "environment"],
      "description": "environment 记录环境诊断，不可作为功能完成或业务验收证据。"
    }
  }
}
