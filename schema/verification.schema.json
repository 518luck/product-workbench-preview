{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "显式验收命令 v1",
  "type": "object",
  "required": ["command", "args"],
  "additionalProperties": false,
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    }
  }
}
