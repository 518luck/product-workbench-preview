{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-blueprint.local/analysis.schema.json",
  "title": "源码分析记录与流程依据 v2",
  "description": "analysis record 或 analysis trace 的输入。源码位置为 UTF-16 半开区间 [start,end)，行列从 1 开始；工具生成凭据、内容指纹与 recordHash，调用者不能自行指定。",
  "oneOf": [
    {
      "type": "object",
      "required": ["reads"],
      "additionalProperties": false,
      "properties": {
        "reads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["records"],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["traces"],
      "additionalProperties": false,
      "properties": {
        "traces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trace"
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "receiptIds",
        "responsibility",
        "inputs",
        "outputs",
        "conditions",
        "calls",
        "sideEffects",
        "exceptions",
        "unknowns",
        "coverage"
      ],
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^u-[a-f0-9]{24}$"
        },
        "receiptIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^r-"
          }
        },
        "responsibility": {
          "$ref": "#/$defs/text"
        },
        "inputs": {
          "$ref": "#/$defs/texts"
        },
        "outputs": {
          "$ref": "#/$defs/texts"
        },
        "conditions": {
          "$ref": "#/$defs/texts"
        },
        "calls": {
          "$ref": "#/$defs/texts"
        },
        "sideEffects": {
          "$ref": "#/$defs/texts"
        },
        "exceptions": {
          "$ref": "#/$defs/texts"
        },
        "unknowns": {
          "$ref": "#/$defs/texts"
        },
        "coverage": {
          "type": "array",
          "description": "逐项解释 analysis list/read 返回的 reviewPoints；每个位置恰好一次。空函数可为 []。位置存在的分析字段不能留空。仅覆盖源码位置不证明解释正确。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pointId", "detail"],
            "properties": {
              "pointId": {
                "type": "string",
                "pattern": "^p-[a-f0-9]{24}$"
              },
              "detail": {
                "$ref": "#/$defs/text",
                "description": "说明该位置的具体行为与结果、适用条件或失败影响，不只复制代码或套用通用摘要。"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unitId", "recordHash"],
          "properties": {
            "kind": {
              "const": "code"
            },
            "unitId": {
              "type": "string",
              "pattern": "^u-[a-f0-9]{24}$"
            },
            "recordHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "text"],
          "properties": {
            "kind": {
              "const": "requirement"
            },
            "source": {
              "enum": ["user", "document"]
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "contextId", "quote"],
          "properties": {
            "kind": {
              "const": "context"
            },
            "contextId": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 8
            }
          },
          "description": "已完整读取且由扫描器识别的工作流原文；不将普通说明文档当成代码实现。"
        }
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "value", "classification", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "target": {
          "type": "string",
          "pattern": "^/(features|product|dependencies|diagrams)(/|$)",
          "description": "最终文档字段的 JSON Pointer。步骤、规则、异常分别关联到对应叶子字段；删除字段使用 value:null。"
        },
        "value": {},
        "classification": {
          "enum": ["observed", "requested", "inferred", "unknown"],
          "description": "推断／未知写入文档时仅允许 notes，值以 [推断]／[未知]（或对应英文标签）明确标注；完成登记要求当前字段的 observed 依据。"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "completionImpact": {
          "enum": ["blocking", "informational"],
          "description": "仅用于 inferred/unknown 的功能 notes。省略等同 blocking；informational 表示只作边界说明，不支持业务完成证据，note 须说明为何不影响当前验收。影响业务或验收的未知保持 blocking。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": ["inferred", "unknown"]
              }
            }
          },
          "then": {
            "required": ["note"]
          }
        }
      ]
    }
  }
}
